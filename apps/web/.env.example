# apps/web/.env.example — copy to .env.local and fill in real values.
# NEVER commit .env.local. Server-only values must not be exposed to the client.

# --- Supabase (public — safe for the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- NVIDIA (server only) ---
NVIDIA_API_KEY=
NVIDIA_EMBED_MODEL=
NVIDIA_EMBED_DIM=
NVIDIA_RERANK_MODEL=

# --- Groq (server only) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- OpenRouter (server only) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- App ---
APP_BASE_URL=http://localhost:3000