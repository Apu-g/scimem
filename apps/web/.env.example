# apps/web/.env.example — copy to .env.local and fill in real values.
# NEVER commit .env.local. Server-only values must not be exposed to the client.

# --- Supabase (public — safe for the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- NVIDIA (server only) ---
NVIDIA_API_KEY=
# Verified 2026-09-20 (S1.3b): nvidia/nemotron-3-embed-1b, dim 2048, needs input_type query|passage
NVIDIA_EMBED_MODEL=
NVIDIA_EMBED_DIM=
NVIDIA_RERANK_MODEL=

# --- Groq (server only) ---
GROQ_API_KEY=
# Verified 2026-09-20 (S1.3b): openai/gpt-oss-20b (fast, strict JSON)
GROQ_MODEL=

# --- OpenRouter (server only) ---
OPENROUTER_API_KEY=
# Verified 2026-09-20 (S1.3b): anthropic/claude-sonnet-5
OPENROUTER_MODEL=

# --- App ---
APP_BASE_URL=http://localhost:3000